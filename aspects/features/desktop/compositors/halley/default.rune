# halley-config-version: 2
# Halley compositor base configuration.
#
# Nix-managed: generated from
#   modules/features/desktop/compositors/halley/default.rune
# and deployed read-only by hjem. Do not edit in ~/.config/halley.
#
# This file is `gather`ed by halley.rune, which is generated by halley.nix and
# overrides values from here (keyboard layout, cursor size, cluster gaps,
# outputs, autostart, and the whole keybinds section).
#
# Sections and fields may be omitted; omitted values use their built-in
# defaults. Strings are quoted, booleans are `true` or `false`, and each
# nested block ends with `end`.

# Optional environment variables for applications launched by Halley.
# Additions and changes apply to future launches after a valid live reload;
# already-running applications keep the environment they started with.
# Removing a variable takes effect after restarting Halley.
#
# env:
#   QT_QPA_PLATFORM "wayland"
#   QT_QPA_PLATFORMTHEME "qt6ct"
# end

# Autostart launches session services through the same shell and environment
# as configured keybind commands. `once` runs only when a real TTY compositor
# session starts. `on-reload` runs after every valid config reload. Nested
# Winit development sessions run neither category.
autostart:
  # once "waybar"
  # once "mako"
  # once "dms run"

  # on-reload "notify-send 'Halley configuration reloaded'"
end

# Outputs (`view:`) are generated by halley.nix from
# features.compositors.monitors and appended in halley.rune.

# Keyboard, pointer-focus, physical-device, touch, and gesture settings.
# Keyboard/focus policy and client gesture protocols are backend-independent.
# Physical device settings apply when Halley owns libinput devices on a tty.
input:
  # Key-repeat frequency in presses per second and the delay before repeating.
  # These drive clients and repeat-enabled compositor keybinds. A rate of 0
  # disables repeat. Both values update without restarting.
  repeat-rate 30
  repeat-delay 500

  # "click" keeps keyboard focus where you click. "hover" follows the pointer
  # across windows and outputs, but never raises windows merely by hovering.
  focus-mode "click"

  # Whether clicking a window also brings it to the top. When false, the click
  # still focuses and activates the window without changing stacking order.
  raise-on-click true

  keyboard:
    # Standard XKB names. Empty variant/options/model use XKB defaults.
    layout "de"
    variant ""
    options ""
    model ""
  end

  gestures:
    # Master switch for Halley's camera gestures. Native client gestures are
    # still passed through when this is false if client-passthrough is true.
    enabled true

    # Send swipe, pinch, and hold sequences to the client under the pointer.
    # Raw touchscreen contacts are controlled separately by touch-passthrough.
    client-passthrough true
    touch-passthrough true

    # The default hybrid routing lets applications own gestures over their
    # windows and lets Halley own gestures on empty field. Holding `modifier`
    # forces eligible gestures to Halley. An active pointer constraint or
    # client grab always remains client-owned.
    pinch-to-zoom true
    pinch-scope "empty-field"      # "empty-field" or "global"
    compositor-scope "global"      # camera pan and ordinary action gestures
    modifier "mod"                 # keybind Mod; also "off" or an exact modifier

    # Two-finger touchpad scrolling pans only when it begins on empty field.
    # Use "off" to always pass finger scrolling through to clients.
    scroll-pan "empty-field"

    # Swipe finger count and optional momentum after a swipe/pinch pan.
    # Set pan-fingers to 0 to disable compositor swipe-panning.
    pan-fingers 3
    pan-momentum true
    pan-decay-rate 6.0
    flick-min-px-per-s 200.0

    # Discrete swipes use `swipe-DIRECTION-FINGERS`; while Apogee is open they
    # use the separate `apogee-swipe-DIRECTION-FINGERS` map. Holds use
    # `hold-FINGERS`. Values may be any built-in compositor keybind action.
    # A configured binding replaces the defaults in its normal/Apogee map.
    # Apogee open/close actions are global unless a pointer constraint or
    # client grab owns the sequence. Opening is interactive and reversible.
    swipe-threshold-px 120.0
    swipe-up-4 "apogee-open"
    apogee-swipe-down-4 "apogee-close"
    # swipe-left-4 "trail-prev"
    # swipe-right-4 "trail-next"
    # hold-3 "toggle-state"
  end

  touchpad:
    tap true
    natural-scroll true
    dwt true                  # disable while typing
    accel-speed 0.3           # -1.0 .. 1.0
    accel-profile "adaptive"
    scroll-method "two-finger"
    click-method "clickfinger"
    tap-button-map "left-right-middle"
    middle-emulation false
    left-handed false
    disabled-on-external-mouse false
    enabled true              # send-events on/off
  end

  mouse:
    natural-scroll false
    accel-speed 0.0
    accel-profile "flat"
    middle-emulation false
    left-handed false
    enabled true
  end

  trackpoint:
    # Uses the same pointer fields as mouse. On-button scrolling is common:
    # scroll-method "on-button-down"
    # scroll-button 274
    # scroll-button-lock false
  end

  trackball:
    # Uses the same pointer fields as mouse.
    # accel-profile "flat"
    # middle-emulation true
  end

  touchscreen:
    # Raw contacts are exposed through wl_touch when a touchscreen is present.
    # map-to-output accepts an exact connector name. The calibration matrix is
    # libinput's row-major 2x3 affine transform.
    # enabled true
    # map-to-output "eDP-1"
    # calibration-matrix [1, 0, 0, 0, 1, 0]
  end

  # Optional exact-name overrides for individual devices. Names match
  # libinput's full device name, ignoring ASCII letter case; partial names do
  # not match. Values layer over the device's class block above.
  #
  devices:
    "Logitech MX Master 3":
      accel-speed 0.6
      natural-scroll true
    end
    "SynPS/2 Synaptics TouchPad":
      tap false
    end
  end
end

# Cursor themes use the standard Xcursor search path and theme inheritance.
# Theme changes are applied immediately to Halley's compositor cursor.
cursor:
  # This configured name is authoritative; Halley does not inherit the theme
  # from its process environment. Theme names are case-sensitive.
  theme "Adwaita"

  # Base logical size. Halley selects the closest frame supplied by the theme
  # for each output scale.
  size 24

  # Hide after a physical keyboard press, without changing pointer focus,
  # grabs, or constraints. Pointer motion, buttons, and scrolling reveal it.
  hide-when-typing true

  # Hide only the rendered cursor while navigating Halley with the keyboard.
  # The pointer position and hover/focus routing are not changed. Physical
  # pointer motion, buttons, and scrolling reveal it immediately.
  hide-on-keyboard-nav true

  # Hide on touch-down so a stale mouse cursor does not sit over touch UI.
  # Physical pointer activity reveals it again.
  hide-on-touch true

  # Hide after this many milliseconds without pointer activity. Set to 0 to
  # disable inactivity hiding.
  hide-after-ms 2000
end

# Window appearance settings. Borders and titlebars apply only to managed
# top-levels; the content radius also clips unmanaged X11 popup windows.
decorations:
  border:
    # Border width in output pixels. It follows camera zoom visually.
    size 3

    # Client-content corner radius in output pixels. The compositor grows the
    # outer border radius concentrically. Set to 0 for square corners.
    radius 0

    # Focused and unfocused colors accept "#rrggbb" or shorthand "#rgb".
    colour-focused "#d65d26"
    colour-unfocused "#333333"
  end

  # Resize managed windows by left-dragging their outer edge or corner. The
  # hit band remains usable when the visible border is thin or hidden.
  resize-using-border true

  # Compositor-owned titlebars are added only to windows using server-side
  # decorations. They replace the border's top edge, not the other 3 sides.
  titlebars:
    enabled true
    # Left uses close/maximize/minimize; right uses minimize/maximize/close.
    button-position "left"
    # The application icon follows the title as one left/center/right group.
    title-position "center"
    show-buttons true
    show-icons false
    show-title true
    radius 0
    height 32

    colour-focused "#d65d26"
    colour-unfocused "#333333"
    foreground-colour-focused "#101418"
    foreground-colour-unfocused "#f4f5f7"
    button-hover-colour "#ffffff"
    button-pressed-colour "#101418"
  end
end

# Destination for PNG files created by the native screenshot menu and the
# desktop portal. `$env.HOME`, `$HOME`, and `~` home-directory spellings are
# supported. Missing directories are created when a screenshot is saved.
screenshot:
  directory "$env.HOME/Pictures/Screenshots/"
end

# Global font for compositor-owned UI. Every compositor label, badge, dialog,
# notification, and overlay uses this exact size.
font:
  family "monospace"
  size 11
end

# Shared compositor-owned UI. This styles Apogee, Alt+Tab, Bearings,
# configuration notices, the zoom indicator, and the exit confirmation.
# Window decorations and node labels keep their own existing configuration.
overlays:
  background-colour "auto"
  text-colour "auto"
  error-colour "#fb4934"
  radius 0
  borders true

  notifications:
    position "top-center"
    success-duration-ms 4000
    error-duration-ms 9000
  end

  # Per-monitor camera scale shown while zooming. Activity keeps the card
  # visible; the hold begins only after input and smooth motion stop.
  zoom-indicator:
    enabled true
    position "bottom-center"
    hold-duration-ms 750
    fade-duration-ms 180
    background true
    opacity 1.0

    # Optional per-indicator visual overrides. Leave these commented to
    # inherit the shared font, palette, border, and radius above.
    # text-size 18
    # text-colour "auto"
    # background-colour "auto"
    # borders true
    # radius 8
  end
end

# Renderer-level visual effects: backdrop blur and shadows.
# These sample or extend the world behind a surface, so they live here rather
# than under `decorations:` (which is compositor chrome attached to surfaces).
effects:
  blur:
    # Allow compositor-owned overlays (Bearings, Apogee, Alt-Tab,
    # notifications, popups, and labels) to use blur.
    overlays true

    # Quality / performance. Dual Kawase is a downsampled multi-pass blur
    # tuned to look Gaussian-ish without a true large-kernel Gaussian's cost.
    method "dual-kawase"
    radius 24
    passes 3

    # Frosted-glass polish.
    saturation 1.10
    noise 0.012
  end

  # Independent shadow layers. blur-radius controls softness; spread expands
  # the solid caster before the falloff; offsets move the shadow in pixels.
  # Colours use #rrggbbaa, with the final byte controlling shadow opacity.
  shadows:
    window:
      enabled true
      blur-radius 8
      spread 0
      offset-x 0
      offset-y 5
      colour "#05030530"
    end

    node:
      enabled true
      blur-radius 14
      spread 0
      offset-x 0
      offset-y 3
      colour "#05030524"
    end

    overlay:
      enabled true
      blur-radius 24
      spread 1
      offset-x 0
      offset-y 7
      colour "#05030538"
    end
  end
end

# The compositor wallpaper is the absolute back of the scene: protocol
# background-layer surfaces, windows, panels, overlays, and the cursor all draw
# above it. "none" creates no wallpaper and leaves empty pixels plain black.
wallpaper:
  mode "field-shader"
  shader "space"
  colour "#181a26"
  accent-colour "#8fa8d8"
  intensity 1.0
  animated true

  # Classic image example. Relative paths resolve beside this config file.
  # mode "classic"
  # path "~/Pictures/wallpaper.png"
  # fit "cover" # "cover", "contain", or "stretch"
  # intensity 1.0

  # Field shader example. "space" is Halley's bundled old-Halley shader; a
  # file path selects a compatible custom fragment shader instead.
  # mode "field-shader"
  # shader "space"
  # colour "#181a26"
  # accent-colour "#8fa8d8"
  # intensity 1.0
  # Animate the old-Halley star field. Set false for a completely static field.
  # animated true
end

# Window and layer-shell rules are the only client blur activation policy.
# Managed-window rules are shared by native Wayland and XWayland windows.
# Rules are checked top-to-bottom and only the first complete match applies.
# Exact strings are case-sensitive; r"..." values are regular expressions.
rules:
  # Keep common Firefox file dialogs centered and floating.
  window-rule:
    app-id "firefox"
    title [r"File Upload.*", r"Open File.*", r"Save File.*", r"Choose.*"]
    spawn-placement "center"
    cluster-participation "float"
  end

  # Frosted-glass terminal: translucent and opted into blur.
  window-rule:
    app-id "Alacritty"
    opacity 0.86
    blur true
  end

  # Never blur video surfaces (rule-level `blur false` always wins).
  window-rule:
    app-id "mpv"
    blur false
  end
end

# Offscreen node navigation. Bearings are laid out independently per monitor
# around that monitor's current camera view. Hold Mod+Z for a temporary view;
# Mod+Shift+Z toggles a persistent view.
bearings:
  show-distance true
  show-icons true
  show-pinned true
  fade-distance 1200.0

  # One shared backdrop capture and blur chain is reused by every chip on an
  # output; disabling this removes the frosted backdrop entirely.
  blur true
end

decay:
  enabled true
  outside-delay-seconds 180
  inside-delay-seconds 1800
end

# Field behavior shared by active windows, collapsed landmarks, and camera
# movement. Active windows may overlap one another; only collapsed landmarks
# reserve readable space against nodes and active windows.
field:
  # Maximized windows are inset from the usable output area by this amount.
  # The same value is the clearance between landmarks and active windows.
  gap 20.0

  # Pinned windows, nodes, and cluster cores stay locked in place. A window
  # with a server titlebar shows its badge opposite the control buttons;
  # fullscreen hides it with the rest of the compositor chrome. The same
  # badge is shown on the entity and on its offscreen Bearings chip.
  pins:
    corner "top-right"
    colour "#d65d26"
    background-colour "auto"
    size 1.0
  end

  # After the focused window closes, prefer the active cluster's next layout
  # member. In tiling, this keeps focus in the vacated slot (and on the newly
  # promoted master); in stacking, it selects the first surviving card. Then
  # fall back to same-output and global MRU order. Set this to false to clear
  # focus instead; the two settings below then have no effect.
  close-restore-focus true

  # The selected successor may already be a collapsed node. False keeps it
  # collapsed while making it Halley's logical node focus, so node-aware
  # commands still target it without unexpectedly turning it back into a
  # window. True restores ("un-nodes") and focuses it as part of the close.
  close-restore-nodes false

  # Camera behavior after focusing an active successor or restoring a node:
  # "never" leaves the camera alone, "if-offscreen" minimally reveals only a
  # fully offscreen successor, and "always" centers the successor. A node kept
  # collapsed by close-restore-nodes false does not move the camera.
  close-restore-pan "if-offscreen"

  # Camera zoom changes both presentation and input coordinates. Halley only
  # zooms outward: 1.0 is native size, and zooming in walks back toward 1.0
  # without magnifying beyond it.
  zoom:
    enabled true
    min 0.35
    step 1.10
    smooth-rate 12.5
  end
end

# Old-Halley contact motion for nodes and node/window displacement. Disable
# this for rigid movement: once contact begins, each unit pushed transfers
# directly to the contacted node or movable node chain.
physics:
  enabled true
  damping 0.45
end

placement:
  landmarks:
    strategy "nearest-free"
    normal-blocker "relocate"
  end
end

node:
  show-labels "hover"
  show-app-icons "always"
  shape "square"
  label-shape "square"
  icon-size 0.72
  opacity 1.0
  background-colour "auto"

  # "never", "if-offscreen", or "always". Panning and restoration begin
  # together; there is no center-first, restore-second interaction.
  click-collapsed-pan "never"
end

debug:
  # The ring is still previewed briefly when its configuration changes.
  show-focus-ring false

  # Show a live per-output FPS chip. This keeps each unlocked output repainting.
  overlay-fps false
end

# Clusters group related windows behind one circular desktop icon. Press the
# cluster-mode binding, click each window you want to include, press Enter,
# type a name, then press Enter again. Escape cancels at either step.
clusters:
  # New clusters open in "stacking" (overlapping cards) or "tiling" (one
  # master window beside a vertical stack). Mod+L changes the active cluster.
  default-layout "stacking"

  # Bloom a collapsed cluster, then Mod-drag a normal window until it docks
  # against the fixed core. Hold it there for this long; the core's own border
  # thickens and a matching accent wash marks the dragged window when the join
  # is armed. Releasing adds it; moving away or releasing early cancels.
  join-dwell-ms 2000

  # Older configs may still contain join-distance-px. It remains accepted for
  # compatibility, but manual bloom joining now uses the actual window/core
  # bounds plus field.gap instead of a center-distance threshold.

  # Draw the restored old-Halley cluster glyph inside each circular core.
  show-icons true

  # Rest the pointer on a collapsed cluster core for 1.7 seconds to reveal
  # its member windows as a circular bloom. Tokens begin above the core;
  # choose "clockwise" or "counter-clockwise" for their ordering direction.
  bloom-direction "clockwise"

  tiling:
    # false appends newly joined windows; true inserts them at the front.
    new-on-top false

    # Outer is the distance from the monitor work area. Inner is the gap
    # between cluster windows. Both values are logical pixels.
    gaps-inner 20.0
    gaps-outer 20.0

    # The master plus this many stack windows are visible. Extra windows stay
    # in the overflow queue instead of being destroyed or removed.
    max-stack 4
    overflow-show-icons true
  end

  stacking:
    # Maximum overlapping cards drawn at once. 0 means no limit.
    max-visible 5
  end
end

# Multi-monitor window overview. It replaces the desktop with tiles over the
# wallpaper only. GPU-local previews coalesce commits at the configured
# ceiling; max-rows accepts the old-Halley range 1 through 5.
apogee:
  enabled true
  live-previews true
  preview-max-fps 30
  transition-ms 320
  gap 24.0
  max-rows 3
  background-dim 0.85
end

# Browser-like per-monitor window focus history. Navigating the trail restores
# collapsed nodes and minimally reveals live windows without disturbing the
# forward history. Cluster workspaces keep their own navigation and are not
# recorded here.
trail:
  history-length 25
  wrap true
end

# Animation settings are reloaded for future motion. Existing window-open and
# window-close animations keep the parameters with which they started.
animations:
  # Master switch for window-open, window-close, fullscreen, maximize, smooth
  # resize, node, and cluster animations.
  enabled true

  # Low-pass filtering for pointer-driven window resize. Lower durations hug
  # the pointer more tightly; higher values feel softer. Release stops at the
  # currently presented size instead of continuing after the pointer lets go.
  smooth-resize:
    enabled true
    duration-ms 90
  end

  window-open:
    # Independent switch for newly mapped windows.
    enabled true

    # Visual style:
    #   "center-out" - scale the window outward from its final center.
    #   "fade"       - keep the final geometry and fade from transparent to
    #                  opaque.
    #   "launch"     - travel along a short arc from the launcher, cursor,
    #                  focused window, or output center. The travel distance
    #                  is capped and the window settles after a tiny overshoot.
    type "center-out"

    # duration-ms is the complete time from the first frame through the
    # settled final frame. Curves redistribute progress inside that time:
    # "linear" advances evenly; "ease-out-quad", "ease-out-cubic", and
    # "ease-out-expo" cover increasingly more distance near the beginning;
    # "elastic" crosses the destination, then settles back. Launch applies
    # the curve once to travel while keeping its opacity and scale phases
    # anchored to the configured duration.
    duration-ms 620
    curve "linear"

    # Recommended launch motion:
    # type "launch"
    # duration-ms 220
    # curve "ease-out-cubic"
    #
    # Window-open motion also accepts `motion "spring"`. With spring motion,
    # use damping-ratio and stiffness as documented below instead of
    # duration-ms and curve.
  end

  window-close:
    # Independent switch for ordinary Wayland and XWayland toplevels.
    enabled true

    # Close counterparts:
    #   "shrink"  - reverse "center-out" into the window's center.
    #   "fade"    - reverse "fade" without changing geometry.
    #   "retract" - reverse "launch" along the same restrained arc toward its
    #               remembered launch origin (or the current fallback origin).
    # Window-to-node transitions always fly and shrink into the node at the
    # window's original stack depth.
    type "shrink"

    # Close animations use the original ease-in-out cubic timing internally.
    duration-ms 270
  end

  fullscreen:
    # Independent switch for fullscreen enter and exit transitions.
    enabled true

    # Motion model:
    #   "spring" - physically settles toward the target using the values
    #              below.
    #   "easing" - uses `duration-ms` and `curve` instead.
    motion "spring"

    # 1.0 is critically damped. Values below 1.0 permit bounce; values above
    # 1.0 remove overshoot but can settle more slowly.
    damping-ratio 1.0

    # Spring strength. Higher values reach the target more aggressively.
    stiffness 800.0

    # Example easing alternative:
    # motion "easing"
    # duration-ms 250
    # curve "ease-out-cubic"
  end

  maximize:
    # Maximize accepts the same spring/easing motion knobs as fullscreen.
    # Its default preserves the original 240 ms ease-in-out cubic feel.
    enabled true

    # Easing motion:
    motion "easing"
    duration-ms 240
    curve "ease-in-out-cubic"

    # Spring alternative:
    # motion "spring"
    # damping-ratio 1.0
    # stiffness 800.0
  end

  node:
    enabled true
    duration-ms 280
  end

  cluster:
    # One switch for cluster workspace motion; it does not affect Field,
    # fullscreen, maximize, node, or cursor behavior.
    enabled true

    tiling:
      # Opening and closing control transitions between the circular core and
      # the 1.0-scale workspace. Reflow covers tile order/size changes.
      open-duration-ms 300
      close-duration-ms 420
      reflow-duration-ms 240

      # Delay between consecutive tile starts. Set to 0 for simultaneous
      # motion while keeping the same open/close durations.
      stagger-ms 55
    end

    stacking:
      open-duration-ms 240
      close-duration-ms 360
      cycle-duration-ms 220
    end
  end
end
