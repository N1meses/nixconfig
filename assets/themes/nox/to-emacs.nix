# Renders nox-default as an Emacs theme file (nox-default-theme.el).
let
  inherit (import ./roles.nix) palette roles;

  # Emacs colours have no alpha channel: "#cccccc99" -> "#cccccc".
  c = name: builtins.substring 0 7 palette.${name};

  attrs =
    a:
    builtins.concatStringsSep " " (
      (if a ? fg then [ ":foreground \"${c a.fg}\"" ] else [ ])
      ++ (if a ? bg then [ ":background \"${c a.bg}\"" ] else [ ])
      ++ (if a.italic or false then [ ":slant italic" ] else [ ])
      ++ (if a.bold or false then [ ":weight bold" ] else [ ])
      ++ (if a.underline or false then [ ":underline t" ] else [ ])
      ++ (if a ? extra then [ a.extra ] else [ ])
    );

  role = name: roles.${name};

  faces = {
    font-lock-comment-face = role "comment";
    font-lock-comment-delimiter-face = role "comment";
    font-lock-doc-face = role "docComment";
    font-lock-doc-markup-face = role "docComment";

    font-lock-string-face = role "string";
    font-lock-number-face = role "number";
    font-lock-escape-face = role "escape";
    font-lock-regexp-face = role "escape";
    font-lock-regexp-grouping-backslash = role "escape";
    font-lock-regexp-grouping-construct = role "escape";
    font-lock-constant-face = role "constant";

    font-lock-keyword-face = role "keyword";
    font-lock-preprocessor-face = role "preproc";
    font-lock-builtin-face = role "special";

    font-lock-function-name-face = role "function";
    font-lock-function-call-face = role "function";

    font-lock-variable-name-face = role "variable";
    font-lock-variable-use-face = role "variable";
    font-lock-property-name-face = role "property";
    font-lock-property-use-face = role "property";

    font-lock-type-face = role "type";
    # defined in nox-theme.el (the Emacs aspect), used by its helix-style rules
    nox-type-builtin-face = role "typeBuiltin";
    nox-namespace-face = role "namespace";
    nox-variable-builtin-face = role "selfRef";

    font-lock-operator-face = role "operator";
    font-lock-negation-char-face = role "operator";
    font-lock-punctuation-face = role "punctuation";
    font-lock-bracket-face = role "punctuation";
    font-lock-delimiter-face = role "punctuation";
    font-lock-misc-punctuation-face = role "punctuation";

    font-lock-warning-face = {
      fg = "warning";
      bold = true;
    };

    default = {
      fg = "text";
      bg = "background";
    };
    cursor.bg = "cursor";
    region.bg = "selection";
    highlight.bg = "highlight";
    hl-line.bg = "cursorline";
    fringe.bg = "background";
    shadow.fg = "virtual_text";
    match.bg = "selection";
    trailing-whitespace.bg = "diff_red";

    line-number = {
      fg = "linenr";
      bg = "background";
    };
    line-number-current-line = {
      fg = "linenr_selected";
      bg = "cursorline";
    };

    mode-line = {
      fg = "white";
      bg = "statusline_bg";
    };
    mode-line-active = {
      fg = "white";
      bg = "statusline_bg";
    };
    mode-line-inactive = {
      fg = "statusline_inactive_fg";
      bg = "statusline_inactive_bg";
    };
    header-line = {
      fg = "text_gray";
      bg = "bufferline_bg";
    };
    vertical-border.fg = "window_border";
    window-divider.fg = "window_border";

    minibuffer-prompt = {
      fg = "blue";
      bold = true;
    };
    completions-common-part.fg = "blue";
    tooltip = {
      fg = "text";
      bg = "popup_bg";
    };

    isearch = {
      fg = "white";
      bg = "menu_selected";
      bold = true;
    };
    lazy-highlight.bg = "cursor_match";

    show-paren-match = {
      fg = "cursor_match_fg";
      bg = "cursor_match";
    };
    show-paren-mismatch = {
      fg = "white";
      bg = "diff_red";
    };

    link = {
      fg = "link_blue";
      underline = true;
    };
    link-visited = {
      fg = "violet";
      underline = true;
    };

    error.fg = "error";
    warning.fg = "warning";
    success.fg = "diff_green";
  };

  faceLines = builtins.concatStringsSep "\n" (
    map (n: "   '(${n} ((t (${attrs faces.${n}}))))") (builtins.attrNames faces)
  );
in
''
  ;;; nox-default-theme.el --- nox, generated from assets/themes/nox -*- lexical-binding: t -*-

  (deftheme nox-default "nox-default, generated by nixconfig.")

  (custom-theme-set-faces
   'nox-default
${faceLines})

  (provide-theme 'nox-default)
''
